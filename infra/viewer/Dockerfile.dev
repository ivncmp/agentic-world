# Development viewer: Vite dev server with HMR.
# Source is volume-mounted — edits reflect instantly in the browser.

FROM node:22-slim
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts
# src/, vite.config.ts, tsconfig.viewer.json are volume-mounted
EXPOSE 80
CMD ["npx", "vite", "--host", "0.0.0.0", "--port", "80"]
