# Copy to .env and fill in. Never commit .env.

# --- Postgres (world state: agents, economy, positions, tick clock) ---
POSTGRES_USER=aw
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agentic_world
POSTGRES_PORT=5532
# SQL browser (dev only, localhost-bound)
PGWEB_PORT=8082

# --- dbrain (agent memory: episodic / relational / identity) ---
# Dedicated clean instance for the simulation — do not share with other brains.
DBRAIN_VERSION=1.0.1
DBRAIN_PORT=7978
DBRAIN_DASHBOARD_PORT=7979
DBRAIN_TOKEN=

# --- Model provider ---
# Two routes: dproxy (local CLI proxy) or direct Anthropic API.
# Set one of them. dproxy is the default — it shells out to the `claude` CLI
# and uses the subscriber's own credentials, so it runs on the host, not in
# this compose. Start it separately and point DPROXY_URL at it.
MODEL_PROVIDER=dproxy
DPROXY_URL=http://localhost:7880
DPROXY_API_KEY=

# Per-purpose model override (omit to use the provider's default)
# SCENE_MODEL=claude-haiku-4-5
# REFLECTION_MODEL=claude-opus-5
# DELIBERATION_MODEL=claude-haiku-4-5
# CRISIS_MODEL=claude-haiku-4-5

# Alternative: direct Anthropic API (set your key; no dproxy needed)
# ANTHROPIC_API_KEY=

# --- engine ---
# Real milliseconds per tick: 2000 = a world day every ~10 minutes
TICK_MS=2000
ENGINE_PORT=7070
VIEWER_PORT=8080
SEED=42
# Set LLM=0 to run the world on the reflex layer alone (no model calls)
LLM=1
# Baked city template (omit for the default)
# CITY_TEMPLATE=

# --- owner auth ---
# Protects agent creation and owner registration. Pick any random string.
ADMIN_SECRET=change-me
