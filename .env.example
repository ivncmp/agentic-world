# Copy to .env and fill in. Never commit .env.

# --- Postgres (world state: agents, economy, positions, tick clock) ---
POSTGRES_USER=aw
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agentic_world
POSTGRES_PORT=5532
# SQL browser (dev only, localhost-bound)
PGWEB_PORT=8082

# --- dbrain (agent memory: episodic / relational / identity) ---
# Dedicated clean instance. Do NOT point this at the shared weepserver brain.
DBRAIN_VERSION=1.0.1
DBRAIN_PORT=7978
DBRAIN_DASHBOARD_PORT=7979

# --- Model provider ---
# dproxy runs on the host (weepserver), not in this compose: it shells out to
# the `claude` CLI and needs the subscriber's OAuth credentials.
# 100.115.51.71 is weepserver over Tailscale.
MODEL_PROVIDER=dproxy
DPROXY_URL=http://100.115.51.71:7880
# DPROXY_API_KEY=            # set if dproxy has server.apiKey configured

# Per-purpose model override (omit to use dproxy's default)
# SCENE_MODEL=claude-haiku-4-5
# REFLECTION_MODEL=claude-opus-5
# DELIBERATION_MODEL=claude-haiku-4-5
# CRISIS_MODEL=claude-haiku-4-5

# Alternative provider, for when structured outputs or throughput are needed.
# ANTHROPIC_API_KEY=

# Path to the dtoolkit checkout, needed until @dtoolkit/dbrain installs from npm
DTOOLKIT_PATH=../dtoolkit

# --- engine ---
# Real milliseconds per tick: 2000 = a world day every ~10 minutes
TICK_MS=2000
ENGINE_PORT=7070
VIEWER_PORT=8080
SEED=42
LLM=1
DBRAIN_TOKEN=

# --- owner auth ---
# Protects agent creation and owner registration. Pick any random string.
ADMIN_SECRET=change-me
