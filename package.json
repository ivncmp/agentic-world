{
  "name": "agentic-world",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/persistence/migrations && cp src/persistence/migrations/*.sql dist/persistence/migrations/",
    "test": "vitest run",
    "check": "tsc --noEmit && eslint src && prettier --check \"src/**/*.ts\" && vitest run",
    "mcp": "tsc -p tsconfig.json && node dist/mcp/index.js",
    "viewer": "vite",
    "viewer:build": "vite build",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "clean": "rm -rf dist",
    "dev": "docker compose up -d",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "three": "^0.185.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.68.0",
    "vite": "8.2.1",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@dtoolkit/sdk": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "bullmq": "^6.2.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "ws": "^8.21.3"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
